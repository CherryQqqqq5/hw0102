+    def test_stack_preserves_dtype(self) -> None:
+        # regression test for GH7393: stacking should not cast index dtypes
+        ds = Dataset(
+            coords={
+                "a": np.array([0, 1], dtype="i4"),
+                "b": np.array([0.0, 1.0], dtype="f4"),
+            }
+        )
+        stacked = ds.stack(z=("a", "b"))
+
+        assert stacked["a"].dtype == ds["a"].dtype
+        assert stacked["b"].dtype == ds["b"].dtype
+        assert stacked["a"].values.dtype == np.dtype("i4")
+        assert stacked["b"].values.dtype == np.dtype("f4")
+
+        for name in ("a", "b"):
+            assert stacked[name].values.dtype == ds[name].values.dtype
+
+        # dtypes are also preserved through a stack / unstack roundtrip
+        unstacked = stacked.unstack("z")
+        assert unstacked["a"].dtype == ds["a"].dtype
+        assert unstacked["b"].dtype == ds["b"].dtype
+
