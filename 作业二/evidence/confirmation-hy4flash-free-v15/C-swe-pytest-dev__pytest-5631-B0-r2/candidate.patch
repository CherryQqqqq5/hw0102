+    def test_getfuncargnames_patch_with_ambiguous_equality_new(self):
+        from _pytest.compat import getfuncargnames
+        from unittest.mock import patch
+
+        class ArrayLike(object):
+            """Mimics an array: equality returns an ambiguous truth value."""
+
+            def __eq__(self, other):
+                return self
+
+            def __bool__(self):
+                raise ValueError(
+                    "The truth value of an array with more than one element is ambiguous"
+                )
+
+            __nonzero__ = __bool__
+
+        @patch("os.getcwd", new=ArrayLike())
+        def f(fixture):
+            pass
+
+        assert getfuncargnames(f) == ("fixture",)
+
