+    def test_loc_dim_name_reserved(self):
+        # regression test for GH4695: a dimension named e.g. "method" must
+        # not clash with .sel()'s keyword arguments when indexing via .loc
+        for dim_name in ["method", "drop", "tolerance", "indexers"]:
+            array = DataArray(
+                np.zeros((2, 2)),
+                dims=["dim1", dim_name],
+                coords={"dim1": ["x", "y"], dim_name: ["a", "b"]},
+            )
+            indexer = {"dim1": "x", dim_name: "a"}
+            assert_identical(array.loc[indexer], array[0, 0])
+            array.loc[indexer] = 1.0
+            assert float(array[0, 0]) == 1.0
+
