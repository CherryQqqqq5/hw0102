-def where(cond, x, y):
+def _attrs_from_first_nonempty(attrs_list, context=None):
+    """Combine attributes by taking the first non-empty set of attributes.
+
+    This is used by :py:func:`where`, where the first argument (``cond``) is
+    often derived from one of the other arguments and may have empty
+    attributes, which should not discard the attributes of the values.
+    """
+    for attrs in attrs_list:
+        if attrs:
+            return dict(attrs)
+    return {}
+
+
