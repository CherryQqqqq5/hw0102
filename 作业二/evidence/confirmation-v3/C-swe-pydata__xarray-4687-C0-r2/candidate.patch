+def _where_keep_attrs(attrs, context=None):
+    """Select the attributes to keep for ``xr.where(..., keep_attrs=True)``.
+
+    Attributes of ``x`` (the second input) are used, consistent with the
+    ``where`` method of ``DataArray`` and ``Dataset``. Falls back to the first
