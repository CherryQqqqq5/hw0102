+def test_refit_time():
+    # Test that the time required to refit the best estimator is exposed
+    X = np.arange(100).reshape(10, 10)
+    y = np.array([0] * 5 + [1] * 5)
+
+    search = GridSearchCV(Ridge(), {'alpha': [1.0, 2.0]})
+    search.fit(X, y)
+    assert_true(hasattr(search, 'refit_time_'))
+    assert_true(search.refit_time_ >= 0)
+
+    search_no_refit = GridSearchCV(Ridge(), {'alpha': [1.0, 2.0]},
+                                   refit=False)
+    search_no_refit.fit(X, y)
+    assert_false(hasattr(search_no_refit, 'refit_time_'))
+
+
