     x1 = deepcopy(x0)
     assert x0.values[0] is not x1.values[0]
+
+
+def test_loc_with_dim_named_method():
+    # regression test for GH2971: dimension names must not collide with
+    # the keyword arguments of ``sel`` (e.g. ``method``)
+    array = DataArray(
+        np.zeros((2, 2)),
+        dims=["dim1", "method"],
+        coords={"dim1": ["x", "y"], "method": ["a", "b"]},
+    )
+    actual = array.loc[dict(dim1="x", method="a")]
+    expected = array.sel({"dim1": "x", "method": "a"})
+    assert_identical(expected, actual)
+
+    array.loc[dict(dim1="x", method="a")] = 5
+    assert array.values[0, 0] == 5
