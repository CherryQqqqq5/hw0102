+from django.db.models import FilteredRelation, Q
+from django.test import TestCase
+
+from .models import Author, Book, Editor
+
+
+class MultipleFilteredRelationTests(TestCase):
+    @classmethod
+    def setUpTestData(cls):
+        cls.editor = Editor.objects.create(name="Editor")
+        cls.author1 = Author.objects.create(name="Alice")
+        cls.author2 = Author.objects.create(name="Jane")
+        Book.objects.create(
+            title="Poem by Alice", author=cls.author1, editor=cls.editor
+        )
+        Book.objects.create(
+            title="The book by Jane A", author=cls.author2, editor=cls.editor
+        )
+
+    def test_two_filtered_relations_same_relation(self):
+        qs = (
+            Author.objects.annotate(
+                book_alice=FilteredRelation(
+                    "book", condition=Q(book__title__iexact="poem by alice")
+                ),
+                book_jane=FilteredRelation(
+                    "book", condition=Q(book__title__iexact="the book by jane a")
+                ),
+            )
+            .values("name", "book_alice__title", "book_jane__title")
+            .order_by("name")
+        )
+        print("SQL:", qs.query)
+        print("ROWS:", list(qs))
+
+    def test_plain_and_filtered_join(self):
+        qs = (
+            Author.objects.annotate(
+                book_alice=FilteredRelation(
+                    "book", condition=Q(book__title__iexact="poem by alice")
+                ),
+            )
+            .values("name", "book_alice__title", "book__title")
+            .order_by("name")
+        )
+        print("SQL2:", qs.query)
+        print("ROWS2:", list(qs))
