@@ -0,0 +1,36 @@
+from django.db.models import Case, F, FilteredRelation, Q, When
+from django.test import TestCase
+
+from .models import Author, Book, Editor
+
+
+class MultipleFilteredRelationReproTests(TestCase):
+    @classmethod
+    def setUpTestData(cls):
+        cls.editor = Editor.objects.create(name="a")
+        cls.author1 = Author.objects.create(name="Alice")
+        cls.author2 = Author.objects.create(name="Jane")
+        Book.objects.create(title="Poem by Alice", author=cls.author1, editor=cls.editor)
+        Book.objects.create(title="Poem by Jane A", author=cls.author2, editor=cls.editor)
+
+    def test_multiple_filtered_relation_same_relation(self):
+        qs = (
+            Author.objects.annotate(
+                book_alice=FilteredRelation(
+                    "book", condition=Q(book__title__contains="Alice")
+                ),
+                book_jane=FilteredRelation(
+                    "book", condition=Q(book__title__contains="Jane")
+                ),
+            )
+            .annotate(
+                title=Case(
+                    When(book_alice__isnull=True, then=F("book_jane__title")),
+                    default=F("book_alice__title"),
+                )
+            )
+            .order_by("pk", "title")
+            .values_list("name", "title")
+        )
+        print("\nSQL:", qs.query)
+        print("RESULT:", list(qs))
