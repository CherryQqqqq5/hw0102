+def test_handler_level_restored_after_test(testdir):
+    """Ensure that the level set on the capture handler by 'set_level'
+    is restored at the end of the test, as documented."""
+    testdir.makepyfile(
+        """
+        def test1(caplog):
+            caplog.set_level(42)
+            assert caplog.handler.level == 42
+
+        def test2(caplog):
+            assert caplog.handler.level == 0
+        """
+    )
+    result = testdir.runpytest()
+    result.assert_outcomes(passed=2)
