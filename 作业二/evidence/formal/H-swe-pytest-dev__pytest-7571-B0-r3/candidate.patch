+
+
+def test_change_handler_level_undo(testdir):
+    """Ensure the handler level changed by ``set_level`` is undone at the end of the test."""
+    testdir.makepyfile(
+        """
+        import logging
+
+        def test1(caplog):
+            caplog.set_level(logging.INFO)
+            assert caplog.handler.level == logging.INFO
+
+        def test2(caplog):
+            assert caplog.handler.level == logging.NOTSET
+    """
+    )
+    result = testdir.runpytest()
+    result.assert_outcomes(passed=2)
